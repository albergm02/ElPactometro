<Window x:Class="TrabajoFinal_ELPACTOMETRO.SecondWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TrabajoFinal_ELPACTOMETRO"
        mc:Ignorable="d"
        Title="Tablas" Height="750" Width="600" WindowStyle="None"
        MouseDown="Window_MouseDown" AllowsTransparency="True" Background="Transparent" Icon="/Imagenes/table.png">

    <Border BorderBrush="{StaticResource BordeVentanas}" BorderThickness="2" 
            Background="{StaticResource FondoVentanas}" CornerRadius="10">

        <Grid x:Name="ventanaSecundaria">

            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="300"/>
                <RowDefinition Height="300"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Barra lateral -->

            <Border Name="barraTitulo" Grid.Row="0" Background="{StaticResource FondoVentanaLateral2}" CornerRadius="5">

                <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>

                    <Button Name="ButtonMinimizeSW" Background="Transparent" Grid.Column="1" BorderBrush="Transparent" Click="ButtonMinimizeSW_Click">
                        <Image Source="/Imagenes/minus-sign.png" Stretch="Uniform" VerticalAlignment="Center" Width="20" Height="20"/>
                    </Button>

                    <Button Name="ButtonFScreenSW" Background="Transparent" Grid.Column="2" BorderBrush="Transparent" Click="ButtonFScreenSW_Click">
                        <Image Source="/Imagenes/maximize.png" Stretch="Uniform" VerticalAlignment="Center" Width="20" Height="20"/>
                    </Button>

                    <Button Name="ButtonCloseSW" Background="Transparent" Grid.Column="3" BorderBrush="Transparent" Click="ButtonCloseSW_Click">
                        <Image Source="/Imagenes/cancel.png" Stretch="Uniform" VerticalAlignment="Center" Width="20" Height="20"/>
                    </Button>

                </Grid>
            </Border>

            <!-- Lista de procesos -->

            <Border x:Name="gridProcesos" Grid.Row="1" Background= "{StaticResource FondoListaProcesos}" Margin="10" CornerRadius="5">
                <ListView Name="TablaProcesos" Margin="5" SelectionChanged="TablaProcesos_SelectionChanged" FontFamily="Georgia" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Eliminar" Click="Eliminar_Click"/>
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn  Width="200" DisplayMemberBinding="{Binding NombreProceso}">
                                <GridViewColumnHeader Tag="nombrePro" HorizontalAlignment="Left"
                                                      Content="NOMBRE DEL PROCESO" Name="NombreProHeader"/>
                            </GridViewColumn>
                            <GridViewColumn Width ="150" DisplayMemberBinding="{Binding FechaProceso}">
                                <GridViewColumnHeader Tag="fechaPro" HorizontalAlignment="Left"
                                                      Content="FECHA" Name="FechaProHeader"/>
                            </GridViewColumn>
                            <GridViewColumn Width ="150" DisplayMemberBinding="{Binding MayoriaAbsoluta}">
                                <GridViewColumnHeader Tag="mayoriaPro" HorizontalAlignment="Left"
                                                      Content="MAYORIA" Name="MayoriaAbsHeader"/>
                            </GridViewColumn>
                            <GridViewColumn Width ="100" DisplayMemberBinding="{Binding NumeroEscañosTotales}">
                                <GridViewColumnHeader Tag="numEscañosT" HorizontalAlignment="Left"
                                                      Content="ESCAÑOS" Name="NumEscañosTHeader"/>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <!-- Lista de partidos -->

            <Border x:Name="gridPartidos" Grid.Row="2" Background= "{StaticResource FondoListaPartidos}" Margin="10" CornerRadius="5">
                <ListView Name="TablaPartidos" Margin="5" FontFamily="Georgia" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn  Width="300" DisplayMemberBinding="{Binding NombrePartido}">
                                <GridViewColumnHeader Tag="nombrePa" HorizontalAlignment="Center"
                                      Content="NOMBRE DEL PARTIDO" Name="NombrePaHeader"/>
                            </GridViewColumn>
                            <GridViewColumn Width ="300" DisplayMemberBinding="{Binding EscañosPartido}">
                                <GridViewColumnHeader Tag="fechaPa" HorizontalAlignment="Center"
                                      Content="NUMERO DE ESCAÑOS" Name="NumEscañosPaHeader"/>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <!-- Botones Modos Comparativo, Pactómetro, Añadir Partido y Añadir Proceso -->

            <Border x:Name="gridModos" Grid.Row="3" Background= "{StaticResource FondoModos}" Margin="10" CornerRadius="5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="botonComparador"  Grid.Column="0" Width="120" Height="50" Content="COMPARAR" Click="BotonComparador_Click" IsEnabled="False" HorizontalAlignment="Left" Margin="10"/>
                    <Button x:Name="botonPactometro"  Grid.Column="1" Width="120" Height="50" Content="PACTÓMETRO" Click="BotonPactometro_Click" IsEnabled="False" HorizontalAlignment="Center" />
                    <Button x:Name="botonAñadirProceso"  Grid.Column="2" Width="120" Height="50" Content="AÑADIR PROCESO" Click="BotonAñadirProceso_Click" HorizontalAlignment="Right" Margin="10"/>
                    <Button x:Name="botonAñadirPartido" Grid.Column="3" Width="120" Height="50" Content="AÑADIR PARTIDO" Click="BotonAñadirPartido_Click"  IsEnabled="False"  HorizontalAlignment="Right" Margin="10" />
                    
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
