<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <!-- Colores usados -->
    
    <Color x:Key="Gris1">#878787</Color>
    <Color x:Key="Gris2">#6D6D6D</Color>
    <Color x:Key="Gris3">#545454</Color>
    <Color x:Key="Gris4">#393939</Color>
    <Color x:Key="Gris5">#2E2E2E</Color>
    <Color x:Key="Negro">#000000</Color>
    <Color x:Key="Blanco">#FFFFFF</Color>
    <Color x:Key="Crema">#E2DBDF</Color>

    <Color x:Key="Naranja1">#FFE19F</Color>
    <Color x:Key="Naranja2">#E6C47A</Color>
    <Color x:Key="Naranja3">#E6BA5A</Color>
    <Color x:Key="Naranja4">#E7B23E</Color>
    <Color x:Key="Naranja5">#FBAD03</Color>


    <!--Borde de ventanas -->

    <SolidColorBrush x:Key="BordeVentanas" Color="{StaticResource Gris5}"/>
    
    <!--Fondo de ventanas generales -->

    <SolidColorBrush x:Key="FondoVentanas" Color="{StaticResource Gris4}"/>

    <!-- Fondo ventanas laterales -->
    
    <SolidColorBrush x:Key="FondoVentanaLateral1" Color="{StaticResource Gris3}"/>
    <SolidColorBrush x:Key="FondoVentanaLateral2" Color="{StaticResource Gris3}"/>
    <SolidColorBrush x:Key="FondoGraficos" Color="{StaticResource Gris1}"/>
    
    <SolidColorBrush x:Key="FondoListaProcesos" Color="{StaticResource Gris1}"/>
    <SolidColorBrush x:Key="FondoListaPartidos" Color="{StaticResource Gris1}"/>

    <!-- Fondo De modos de la ventana Secundaria-->

    <SolidColorBrush x:Key="FondoModos" Color="{StaticResource Naranja1}"/>

    <!--Fondo de ventana comparativa -->

    <SolidColorBrush x:Key="FondoVentanaComparativa" Color="{StaticResource Naranja2}"/>

    <!--Fondo de ventana del pactómetro -->

    <LinearGradientBrush x:Key="FondoPactometro">
        <GradientStop Color="{StaticResource Naranja1}" Offset="0.0" />
        <GradientStop Color="{StaticResource Naranja3}" Offset="0.5" />
        <GradientStop Color="{StaticResource Naranja5}" Offset="1.0" />
    </LinearGradientBrush>

    <!--Fondo de ventana del pactómetro -->

    <SolidColorBrush x:Key="FondoVentanaPresentacionPactometro" Color="{StaticResource Crema}"/>

    <!--Fondo del comboBox -> AñadirPartido -->

    <SolidColorBrush x:Key="FondoComboBox" Color="{StaticResource Gris1}"/>

</ResourceDictionary>